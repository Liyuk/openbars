# `openbars init` writes this file as .env. Fill in your own keys. Never commit .env.
# Fill in your own keys; never commit .env.
#
# openbars reads keys from (highest wins):
#   1. the process environment
#   2. a dotenv file: --env-file, else OPENBARS_ENV_FILE, else config.yaml `env_file`,
#      else ./.env next to config.yaml (loaded automatically when it exists)
#   3. ${VAR:-default} in config.yaml
# Literal values in config.yaml are used as written. `openbars config` prints the
# effective settings with every secret redacted (set / missing).
#
# OPENBARS_ENV_FILE=.env
#
# Alpaca aliases: ALPACA_API_KEY / ALPACA_API_SECRET are accepted when
# ALPACA_API_KEY_ID / ALPACA_API_SECRET_KEY are unset.

# --- US equities / ETF ---
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
MASSIVE_API_KEY=
TIINGO_API_KEY=
ALPHA_VANTAGE_API_KEY=
TWELVE_DATA_API_KEY=

# --- China A-shares (v0.4+) ---
# Required only for providers.tushare (free tier, unadjusted daily bars; openbars[tushare]).
# The config references it as ${TUSHARE_TOKEN}; never commit the real value.
TUSHARE_TOKEN=

# --- Optional Postgres backend ---
OPENBARS_PG_DSN=

# --- Optional remote collector node shared secret ---
OPENBARS_NODE_TOKEN=
